// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Python Debugger (Linux)",
    "adapter": "Debugpy",
    "request": "attach",
    "connect": {
      "host": "127.0.0.1",
      "port": 5678,
    },
    "justMyCode": true,
    "pathMappings": [
      {
        "localRoot": "$ZED_WORKTREE_ROOT/geovcs",
        "remoteRoot": "~/.local/share/QGIS/QGIS4/profiles/default/python/plugins/geovcs",
      },
    ],
  },
]
